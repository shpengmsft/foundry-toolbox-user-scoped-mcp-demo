# demo, fake_oauth, github, entra_passthrough, or entra
AUTH_MODE=demo

# Required when AUTH_MODE=entra or entra_passthrough
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Required in entra mode. Optional in entra_passthrough mode; when supplied,
# the forwarded JWT must match this audience.
ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
ENTRA_REQUIRED_SCOPE=mcp.access
ENGINEERING_USER_IDS=11111111-1111-1111-1111-111111111111
FINANCE_USER_IDS=22222222-2222-2222-2222-222222222222
ADMIN_USER_IDS=

# Optional when AUTH_MODE=github.
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=10

# Requests without an Origin header, including normal server-to-server calls,
# are allowed. Browser-originated calls must match this list.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SERVER_HOST=127.0.0.1

# Demo-only OAuth provider settings. Used when AUTH_MODE=fake_oauth.
FAKE_OAUTH_ISSUER=http://localhost:8000
FAKE_OAUTH_AUDIENCE=user-scoped-mcp-demo
FAKE_OAUTH_CLIENT_ID=foundry-test-client
FAKE_OAUTH_REDIRECT_URIS=http://localhost:8400/callback
FAKE_OAUTH_ACCESS_TOKEN_SECONDS=900
FAKE_OAUTH_REFRESH_TOKEN_SECONDS=28800
